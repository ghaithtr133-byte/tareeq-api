PORT=3000
NODE_ENV=development

# Use a pooled Neon URL at runtime and a direct development-only URL for migrations.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require
DIRECT_DATABASE_URL=postgresql://user:password@direct-host/database?sslmode=require

# Generate a cryptographically random value of at least 32 characters.
JWT_SECRET=replace-with-a-secure-random-secret

# Comma-separated exact origins; never use * with credentialed requests.
AUTH_ALLOWED_ORIGINS=http://localhost:3001

# Used only by the explicitly invoked initial SUPER_ADMIN bootstrap command.
BOOTSTRAP_SUPER_ADMIN_NAME=Initial Administrator
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-strong-password
