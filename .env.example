# Optional. Local Node server port; defaults to 3000.
PORT=3000

# Optional. development, test, or production; defaults to development.
# production enables Secure authentication cookies.
NODE_ENV=development

# Required by the running API. Backend-only pooled Neon PostgreSQL URL.
DATABASE_URL=postgresql://user:password@pooled-host/database?sslmode=require

# Required for the approved migration workflow. Backend-only direct/unpooled
# URL for the same Neon database. Prisma falls back to DATABASE_URL when this
# is absent, but migrations should use the direct URL.
DIRECT_DATABASE_URL=postgresql://user:password@direct-host/database?sslmode=require

# Required by authentication. Generate a private random value of 32+ characters.
JWT_SECRET=replace-with-at-least-32-random-characters

# Required by authentication and Admin APIs. Comma-separated exact Frontend
# origins, with scheme and optional port but no path. Replace with an approved
# localhost origin for local Admin development. Never use * with credentials.
AUTH_ALLOWED_ORIGINS=https://admin.tareeq-academy.com

# Optional. Comma-separated exact student/frontend origins allowed to make
# non-credentialed GET/HEAD content requests and POST only to the separately
# approved application/inquiry routes. Replace with the local Public Website
# origin when testing browser CORS locally.
PUBLIC_ALLOWED_ORIGINS=https://tareeq-academy.com

# Optional until email delivery is enabled. Both RESEND_API_KEY and
# RESEND_FROM_EMAIL are required to dispatch persisted notification intents.
# Keep these server-only. The optional reply-to value must also be an email.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
RESEND_REPLY_TO_EMAIL=

# Required before enabling the protected scheduled dispatch route. Use the same
# private value (at least 32 characters) in the Backend and GitHub Actions Secret.
CRON_SECRET=

# Reversible demo seeding is disabled unless the target host:port/database name
# matches exactly. Write and publication switches must remain false by default.
# Never include a username or password in DEMO_SEED_TARGET_ID.
DEMO_SEED_TARGET_ID=
DEMO_SEED_ALLOW_WRITES=false
DEMO_SEED_ALLOW_PUBLICATION=false

# Required only for authenticated Admin image uploads. Keep the API secret on
# the Backend. CLOUDINARY_FOLDER controls the safe public-ID prefix and may use
# slash-separated letters, numbers, underscores, and hyphens.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=tareeq-academy

# Optional during normal runtime. All three become required only when the
# one-time `npm run auth:bootstrap` command is explicitly authorized.
BOOTSTRAP_SUPER_ADMIN_NAME=Initial Administrator
BOOTSTRAP_SUPER_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_SUPER_ADMIN_PASSWORD=replace-with-a-12-plus-character-password1A

# Required only for the explicit, idempotent `npm run admins:provision`
# command. Passwords must be 9-128 characters and include at least one
# lowercase and one uppercase English letter; numbers and symbols are optional.
# Keep real values in the Git-ignored .env file only.
INITIAL_ADMIN_NAME=
INITIAL_ADMIN_EMAIL=
INITIAL_ADMIN_PASSWORD=

INITIAL_SUPER_ADMIN_NAME=
INITIAL_SUPER_ADMIN_EMAIL=
INITIAL_SUPER_ADMIN_PASSWORD=
