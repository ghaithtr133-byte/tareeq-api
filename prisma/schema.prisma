generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum PublicationStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum ScholarshipApplicationStatus {
  OPEN
  CLOSED
}

enum StudentApplicationType {
  UNIVERSITY_ADMISSION
  SCHOLARSHIP_ASSISTANCE
}

enum SubmissionStatus {
  NEW
  IN_REVIEW
  RESOLVED
  CLOSED
}

enum EmailNotificationType {
  APPLICATION_ADMIN
  APPLICATION_STUDENT
  INQUIRY_ADMIN
  INQUIRY_STUDENT
}

enum EmailNotificationState {
  PENDING
  PROCESSING
  SENT
  FAILED
  SKIPPED
}

enum AuditResourceType {
  COUNTRY
  UNIVERSITY
  SCHOLARSHIP
  SERVICE
  ARTICLE
  STUDENT_APPLICATION
  GENERAL_INQUIRY
  ADMIN_USER
  SITE_SETTINGS
  FAQ_ENTRY
  UNIVERSITY_PROGRAM
  ACADEMIC_MAJOR
  CITY
  UNIVERSITY_ADMISSION_REQUIREMENT
  UNIVERSITY_GALLERY_IMAGE
  ABOUT_US
  MARKETING_PAGE_IMAGE
  STUDENT_JOURNEY_STEP
  COUNTRY_STUDY_GUIDE_SECTION
  SERVICE_DETAIL_ITEM
  SCHOLARSHIP_DETAIL_ITEM
}

enum ServiceDetailItemKind {
  STEP
  BENEFIT
}

enum ScholarshipDetailItemKind {
  BENEFIT
  REQUIREMENT
  APPLICATION_STEP
}

enum FaqScope {
  GLOBAL
  COUNTRY
  UNIVERSITY
  SERVICE
  SCHOLARSHIP
}

enum ProgramStudyLevel {
  FOUNDATION
  DIPLOMA
  BACHELORS
  MASTERS
  PHD
}

enum TeachingLanguage {
  ARABIC
  ENGLISH
  FRENCH
  GERMAN
  TURKISH
  ROMANIAN
  RUSSIAN
  SPANISH
  ITALIAN
}

enum UniversityType {
  PUBLIC
  PRIVATE
}

enum ProgramDurationUnit {
  MONTHS
  YEARS
}

enum TuitionBillingPeriod {
  YEAR
  SEMESTER
  FULL_PROGRAM
}

enum AdmissionRequirementScope {
  UNIVERSITY
  STUDY_LEVEL
  PROGRAM
}

enum AnalyticsEventType {
  PAGE_VIEW
  CTA_CLICK
  ENGAGEMENT
  APPLICATION_SUBMITTED
  INQUIRY_SUBMITTED
}

enum AnalyticsCtaId {
  APPLY_NOW
  REQUEST_CONSULTATION
  CONTACT_US
  VIEW_UNIVERSITY
  VIEW_SCHOLARSHIP
  VIEW_SERVICE
}

enum AnalyticsEngagementType {
  SCROLL_50
  SCROLL_90
  ACTIVE_30_SECONDS
  ACTIVE_60_SECONDS
}

model AdminUser {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  email              String              @unique @db.Citext
  passwordHash       String
  role               AdminRole
  isActive           Boolean             @default(true)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  refreshSessions    RefreshSession[]
  emailNotifications EmailNotification[]
  auditLogs          AdminAuditLog[]
  hardDeleteChallenges HardDeleteChallenge[]
}

model AdminAuditLog {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAdminId String            @db.Uuid
  action       String
  resourceType AuditResourceType
  resourceId   String            @db.Uuid
  metadata     Json              @default("{}")
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  actor        AdminUser         @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([createdAt(sort: Desc), id(sort: Desc)])
  @@index([actorAdminId, createdAt(sort: Desc), id(sort: Desc)])
  @@index([action, createdAt(sort: Desc), id(sort: Desc)])
  @@index([resourceType, createdAt(sort: Desc), id(sort: Desc)])
}

model HardDeleteChallenge {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  actorAdminId String            @db.Uuid
  resourceType AuditResourceType
  resourceId   String            @db.Uuid
  impactHash   String            @db.Char(64)
  expiresAt    DateTime          @db.Timestamptz(3)
  consumedAt   DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  actor        AdminUser         @relation(fields: [actorAdminId], references: [id], onDelete: Restrict)

  @@index([actorAdminId, resourceType, resourceId, expiresAt])
  @@index([expiresAt])
}

model SiteSettings {
  id            String   @id @db.Uuid
  academyNameAr String?
  academyNameEn String?
  contactEmail  String?  @db.Citext
  contactPhone  String?
  addressAr     String?
  addressEn     String?
  facebookUrl   String?
  instagramUrl  String?
  linkedinUrl   String?
  youtubeUrl    String?
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

enum MarketingPageKey {
  HOME
  DESTINATIONS
}

model MarketingPageImage {
  id              String           @id @db.Uuid
  pageKey         MarketingPageKey @unique
  heroImageUrl    String?
  heroImageAltAr  String?
  ctaImageUrl     String?
  ctaImageAltAr   String?
  createdAt       DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime         @updatedAt @db.Timestamptz(3)
}

model StudentJourneyStep {
  id            String   @id @db.Uuid
  slot          Int      @unique
  titleAr       String?
  titleEn       String?
  descriptionAr String?
  descriptionEn String?
  displayOrder  Int      @unique
  iconKey       String?
  isActive      Boolean  @default(false)
  createdAt     DateTime @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime @updatedAt @db.Timestamptz(3)
}

model AboutUs {
  id                   String            @id @db.Uuid
  heroTitleAr          String?
  heroTitleEn          String?
  heroSubtitleAr       String?
  heroSubtitleEn       String?
  heroImageUrl         String?
  heroImageAltAr       String?
  heroImageAltEn       String?
  introTitleAr         String?
  introTitleEn         String?
  introBodyAr          String?
  introBodyEn          String?
  introImageUrl        String?
  introImageAltAr      String?
  introImageAltEn      String?
  missionTitleAr       String?
  missionTitleEn       String?
  missionBodyAr        String?
  missionBodyEn        String?
  visionTitleAr        String?
  visionTitleEn        String?
  visionBodyAr         String?
  visionBodyEn         String?
  ctaTitleAr           String?
  ctaTitleEn           String?
  ctaDescriptionAr     String?
  ctaDescriptionEn     String?
  ctaButtonLabelAr     String?
  ctaButtonLabelEn     String?
  seoTitleAr           String?
  seoDescriptionAr     String?
  status               PublicationStatus @default(DRAFT)
  publishedAt          DateTime?         @db.Timestamptz(3)
  createdAt            DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime          @updatedAt @db.Timestamptz(3)
}

model AnalyticsEvent {
  id             String                   @id @db.Uuid
  visitorId      String                   @db.Uuid
  sessionId      String                   @db.Uuid
  type           AnalyticsEventType
  path           String                   @db.VarChar(500)
  targetPath     String?                  @db.VarChar(500)
  referrerHost   String?                  @db.VarChar(253)
  referrerPath   String?                  @db.VarChar(500)
  utmSource      String?                  @db.VarChar(100)
  utmMedium      String?                  @db.VarChar(100)
  utmCampaign    String?                  @db.VarChar(100)
  utmContent     String?                  @db.VarChar(100)
  utmTerm        String?                  @db.VarChar(100)
  ctaId          AnalyticsCtaId?
  engagementType AnalyticsEngagementType?
  occurredAt     DateTime                 @db.Timestamptz(3)
  receivedAt     DateTime                 @default(now()) @db.Timestamptz(3)

  @@index([occurredAt(sort: Desc), id(sort: Desc)])
  @@index([sessionId, occurredAt, id])
  @@index([type, occurredAt(sort: Desc)])
  @@index([path, occurredAt(sort: Desc)])
  @@index([utmSource, utmMedium, occurredAt(sort: Desc)])
}

model RefreshSession {
  id         String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     String    @db.Uuid
  tokenHash  String    @unique
  expiresAt  DateTime  @db.Timestamptz(3)
  revokedAt  DateTime? @db.Timestamptz(3)
  createdAt  DateTime  @default(now()) @db.Timestamptz(3)
  lastUsedAt DateTime? @db.Timestamptz(3)
  user       AdminUser @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
  @@index([expiresAt])
}

model Country {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr              String
  nameEn              String?
  slug                String               @unique
  introductionAr      String
  introductionEn      String?
  detailsAr           String
  detailsEn           String?
  imageUrl            String?
  imageAltAr          String?
  imageAltEn          String?
  overviewImageUrl    String?
  overviewImageAltAr  String?
  studyLanguageAr     String?
  tuitionSummaryAr    String?
  admissionSummaryAr  String?
  applicationDatesSummaryAr String?
  countryCode         String?              @db.VarChar(2)
  featured            Boolean              @default(false)
  displayOrder        Int                  @default(0)
  status              PublicationStatus    @default(DRAFT)
  publishedAt         DateTime?            @db.Timestamptz(3)
  seoTitleAr          String?
  seoDescriptionAr    String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  universities        University[]
  scholarships        Scholarship[]
  articles            Article[]
  studentApplications StudentApplication[]
  faqEntries          FaqEntry[]
  cities              City[]
  studyGuideSections  CountryStudyGuideSection[]

  @@index([status, featured, displayOrder, id])
  @@index([createdAt, id])
  @@unique([countryCode])
}

model CountryStudyGuideSection {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId    String   @db.Uuid
  titleAr      String
  bodyAr       String
  displayOrder Int
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)
  country      Country  @relation(fields: [countryId], references: [id], onDelete: Restrict)

  @@index([countryId, displayOrder, id])
}

model University {
  id                    String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  nameAr                String
  nameEn                String?
  officialName          String
  slug                  String                           @unique
  countryId             String                           @db.Uuid
  cityId                String?                          @db.Uuid
  universityType        UniversityType?
  cityAr                String
  cityEn                String?
  overviewAr            String
  overviewEn            String?
  officialWebsite       String?
  imageUrl              String?
  imageAltAr            String?
  imageAltEn            String?
  logoUrl               String?
  logoAltAr             String?
  logoAltEn             String?
  featured              Boolean                          @default(false)
  displayOrder          Int                              @default(0)
  status                PublicationStatus                @default(DRAFT)
  publishedAt           DateTime?                        @db.Timestamptz(3)
  seoTitleAr            String?
  seoDescriptionAr      String?
  createdAt             DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                         @updatedAt @db.Timestamptz(3)
  country               Country                          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  city                  City?                            @relation(fields: [cityId], references: [id], onDelete: Restrict)
  scholarships          Scholarship[]
  articles              Article[]
  studentApplications   StudentApplication[]
  faqEntries            FaqEntry[]
  programs              UniversityProgram[]
  admissionRequirements UniversityAdmissionRequirement[]
  galleryImages         UniversityGalleryImage[]

  @@index([countryId, status, featured, createdAt, id])
  @@index([cityId, status, createdAt, id])
  @@index([universityType, status, createdAt, id])
  @@index([status, createdAt, id])
}

model City {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  countryId    String       @db.Uuid
  slug         String       @unique
  nameAr       String
  nameEn       String
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)
  country      Country      @relation(fields: [countryId], references: [id], onDelete: Restrict)
  universities University[]

  @@index([countryId, nameAr, id])
}

model AcademicMajor {
  id        String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug      String              @unique
  nameAr    String
  nameEn    String
  category  String?
  createdAt DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt DateTime            @updatedAt @db.Timestamptz(3)
  programs  UniversityProgram[]

  @@index([nameAr, id])
  @@index([category, nameAr, id])
}

model UniversityProgram {
  id                    String                           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId          String                           @db.Uuid
  academicMajorId       String                           @db.Uuid
  nameAr                String?
  nameEn                String?
  facultyNameAr         String?
  facultyNameEn         String?
  durationValue         Int?
  durationUnit          ProgramDurationUnit?
  studyLevel            ProgramStudyLevel
  status                PublicationStatus                @default(DRAFT)
  officialSourceUrl     String
  verifiedAt            DateTime                         @db.Timestamptz(3)
  publishedAt           DateTime?                        @db.Timestamptz(3)
  createdAt             DateTime                         @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime                         @updatedAt @db.Timestamptz(3)
  university            University                       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  academicMajor         AcademicMajor                    @relation(fields: [academicMajorId], references: [id], onDelete: Restrict)
  languages             UniversityProgramLanguage[]
  tuitionFees           UniversityProgramTuition[]
  admissionRequirements UniversityAdmissionRequirement[]

  @@unique([universityId, academicMajorId, studyLevel, nameAr])
  @@index([universityId, status, studyLevel, id])
  @@index([academicMajorId, status, studyLevel, universityId])
  @@index([status, studyLevel, universityId])
  @@index([universityId, facultyNameAr, status, id])
}

model UniversityProgramLanguage {
  programId String            @db.Uuid
  language  TeachingLanguage
  createdAt DateTime          @default(now()) @db.Timestamptz(3)
  program   UniversityProgram @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@id([programId, language])
  @@index([language, programId])
}

model UniversityProgramTuition {
  id            String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  programId     String               @db.Uuid
  amount        Decimal              @db.Decimal(12, 2)
  currency      String               @db.VarChar(3)
  billingPeriod TuitionBillingPeriod
  academicYear  String               @db.VarChar(9)
  createdAt     DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime             @updatedAt @db.Timestamptz(3)
  program       UniversityProgram    @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@unique([programId, academicYear])
  @@index([programId, academicYear(sort: Desc), id])
}

model UniversityAdmissionRequirement {
  id                String                    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId      String                    @db.Uuid
  scope             AdmissionRequirementScope
  studyLevel        ProgramStudyLevel?
  programId         String?                   @db.Uuid
  contentAr         String
  contentEn         String?
  status            PublicationStatus         @default(DRAFT)
  officialSourceUrl String?
  verifiedAt        DateTime?                 @db.Timestamptz(3)
  publishedAt       DateTime?                 @db.Timestamptz(3)
  createdAt         DateTime                  @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                  @updatedAt @db.Timestamptz(3)
  university        University                @relation(fields: [universityId], references: [id], onDelete: Restrict)
  program           UniversityProgram?        @relation(fields: [programId], references: [id], onDelete: Restrict)

  @@index([universityId, status, scope, id])
  @@index([universityId, studyLevel, status, id])
  @@index([programId, status, id])
}

model UniversityGalleryImage {
  id           String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  universityId String            @db.Uuid
  imageUrl     String
  altAr        String?
  altEn        String?
  displayOrder Int               @default(0)
  status       PublicationStatus @default(DRAFT)
  publishedAt  DateTime?         @db.Timestamptz(3)
  createdAt    DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime          @updatedAt @db.Timestamptz(3)
  university   University        @relation(fields: [universityId], references: [id], onDelete: Restrict)

  @@index([universityId, status, displayOrder, id])
}

model Scholarship {
  id                  String                       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr             String
  titleEn             String?
  slug                String                       @unique
  countryId           String?                      @db.Uuid
  universityId        String?                      @db.Uuid
  studyLevel          String
  fundingType         String
  requirementsAr      String
  requirementsEn      String?
  descriptionAr       String
  descriptionEn       String?
  imageUrl            String?
  imageAltAr          String?
  imageAltEn          String?
  verifiedDeadline    DateTime?                    @db.Timestamptz(3)
  officialSourceUrl   String?
  applicationStatus   ScholarshipApplicationStatus @default(OPEN)
  status              PublicationStatus            @default(DRAFT)
  featured            Boolean                      @default(false)
  displayOrder        Int                          @default(0)
  publishedAt         DateTime?                    @db.Timestamptz(3)
  seoTitleAr          String?
  seoDescriptionAr    String?
  createdAt           DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime                     @updatedAt @db.Timestamptz(3)
  country             Country?                     @relation(fields: [countryId], references: [id], onDelete: Restrict)
  university          University?                  @relation(fields: [universityId], references: [id], onDelete: Restrict)
  articles            Article[]                    @relation("LegacyArticleScholarship")
  relatedArticles     ArticleScholarship[]
  studentApplications StudentApplication[]
  faqEntries          FaqEntry[]
  detailItems         ScholarshipDetailItem[]

  @@index([countryId, status, featured, createdAt, id])
  @@index([universityId, status, createdAt, id])
  @@index([status, applicationStatus, verifiedDeadline, id])
  @@index([studyLevel, fundingType])
}

model ScholarshipDetailItem {
  id                String                     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scholarshipId     String                     @db.Uuid
  kind              ScholarshipDetailItemKind
  titleAr           String
  descriptionAr     String?
  displayOrder      Int
  category          String?
  amount            Decimal?                   @db.Decimal(12, 2)
  currency          String?                    @db.VarChar(3)
  coveragePeriod    String?
  officialSourceUrl String?
  verifiedAt        DateTime?                  @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)
  scholarship       Scholarship                @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)

  @@index([scholarshipId, kind, displayOrder, id])
}

model Service {
  id               String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr          String
  titleEn          String?
  slug             String            @unique
  summaryAr        String
  summaryEn        String?
  descriptionAr    String
  descriptionEn    String?
  imageUrl         String?
  imageAltAr       String?
  imageAltEn       String?
  featured         Boolean           @default(false)
  displayOrder     Int               @default(0)
  status           PublicationStatus @default(DRAFT)
  publishedAt      DateTime?         @db.Timestamptz(3)
  seoTitleAr       String?
  seoDescriptionAr String?
  createdAt        DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @db.Timestamptz(3)
  faqEntries       FaqEntry[]
  detailItems      ServiceDetailItem[]

  @@index([status, featured, displayOrder, id])
  @@index([createdAt, id])
}

model ServiceDetailItem {
  id           String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  serviceId    String                @db.Uuid
  kind         ServiceDetailItemKind
  titleAr      String
  descriptionAr String?
  displayOrder Int
  createdAt    DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime              @updatedAt @db.Timestamptz(3)
  service      Service               @relation(fields: [serviceId], references: [id], onDelete: Restrict)

  @@index([serviceId, kind, displayOrder, id])
}

model FaqEntry {
  id            String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  scope         FaqScope
  questionAr    String
  answerAr      String
  questionEn    String?
  answerEn      String?
  status        PublicationStatus @default(DRAFT)
  displayOrder  Int               @default(0)
  publishedAt   DateTime?         @db.Timestamptz(3)
  countryId     String?           @db.Uuid
  universityId  String?           @db.Uuid
  serviceId     String?           @db.Uuid
  scholarshipId String?           @db.Uuid
  createdAt     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime          @updatedAt @db.Timestamptz(3)
  country       Country?          @relation(fields: [countryId], references: [id], onDelete: Restrict)
  university    University?       @relation(fields: [universityId], references: [id], onDelete: Restrict)
  service       Service?          @relation(fields: [serviceId], references: [id], onDelete: Restrict)
  scholarship   Scholarship?      @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)

  @@index([scope, status, displayOrder, id])
  @@index([countryId, status, displayOrder, id])
  @@index([universityId, status, displayOrder, id])
  @@index([serviceId, status, displayOrder, id])
  @@index([scholarshipId, status, displayOrder, id])
}

model Article {
  id                  String               @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  titleAr             String
  titleEn             String?
  slug                String               @unique
  summaryAr           String
  summaryEn           String?
  bodyAr              Json
  bodyEn              Json?
  coverImageUrl       String?
  coverImageAltAr     String?
  coverImageAltEn     String?
  countryId           String?              @db.Uuid
  universityId        String?              @db.Uuid
  scholarshipId       String?              @db.Uuid
  featured            Boolean              @default(false)
  displayOrder        Int                  @default(0)
  status              PublicationStatus    @default(DRAFT)
  publishedAt         DateTime?            @db.Timestamptz(3)
  seoTitleAr          String?
  seoDescriptionAr    String?
  createdAt           DateTime             @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime             @updatedAt @db.Timestamptz(3)
  country             Country?             @relation(fields: [countryId], references: [id], onDelete: Restrict)
  university          University?          @relation(fields: [universityId], references: [id], onDelete: Restrict)
  scholarship         Scholarship?         @relation("LegacyArticleScholarship", fields: [scholarshipId], references: [id], onDelete: Restrict)
  relatedScholarships ArticleScholarship[]

  @@index([countryId, status, createdAt, id])
  @@index([universityId, status, createdAt, id])
  @@index([scholarshipId, status, createdAt, id])
  @@index([status, featured, createdAt, id])
}

model ArticleScholarship {
  articleId     String      @db.Uuid
  scholarshipId String      @db.Uuid
  displayOrder  Int
  createdAt     DateTime    @default(now()) @db.Timestamptz(3)
  article       Article     @relation(fields: [articleId], references: [id], onDelete: Cascade)
  scholarship   Scholarship @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)

  @@id([articleId, scholarshipId])
  @@unique([articleId, displayOrder])
  @@index([scholarshipId, articleId])
}

model StudentApplication {
  id                 String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  applicationType    StudentApplicationType
  scholarshipId      String?                @db.Uuid
  countryId          String?                @db.Uuid
  universityId       String?                @db.Uuid
  studyLevel         String?
  intendedMajor      String?
  fullName           String
  email              String                 @db.Citext
  phone              String?
  message            String
  status             SubmissionStatus       @default(NEW)
  internalNote       String?
  privacyAcceptedAt  DateTime               @db.Timestamptz(3)
  createdAt          DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime               @updatedAt @db.Timestamptz(3)
  scholarship        Scholarship?           @relation(fields: [scholarshipId], references: [id], onDelete: Restrict)
  country            Country?               @relation(fields: [countryId], references: [id], onDelete: Restrict)
  university         University?            @relation(fields: [universityId], references: [id], onDelete: Restrict)
  emailNotifications EmailNotification[]

  @@index([status, createdAt, id])
  @@index([applicationType, status, createdAt, id])
  @@index([scholarshipId])
  @@index([countryId])
  @@index([universityId])
}

model GeneralInquiry {
  id                 String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  fullName           String
  email              String              @db.Citext
  phone              String?
  subject            String
  message            String
  status             SubmissionStatus    @default(NEW)
  internalNote       String?
  privacyAcceptedAt  DateTime            @db.Timestamptz(3)
  createdAt          DateTime            @default(now()) @db.Timestamptz(3)
  updatedAt          DateTime            @updatedAt @db.Timestamptz(3)
  emailNotifications EmailNotification[]

  @@index([status, createdAt, id])
}

model PublicSubmissionRateLimit {
  scope           String
  identifierHash  String   @db.Char(64)
  windowStartedAt DateTime @db.Timestamptz(3)
  count           Int
  expiresAt       DateTime @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @db.Timestamptz(3)

  @@id([scope, identifierHash, windowStartedAt])
  @@index([expiresAt])
}

model EmailNotification {
  id                String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type              EmailNotificationType
  state             EmailNotificationState @default(PENDING)
  applicationId     String?                @db.Uuid
  inquiryId         String?                @db.Uuid
  adminUserId       String?                @db.Uuid
  recipient         String                 @db.Citext
  idempotencyKey    String                 @unique
  attemptCount      Int                    @default(0)
  providerMessageId String?
  lastErrorCode     String?
  nextAttemptAt     DateTime               @db.Timestamptz(3)
  retryUntil        DateTime               @db.Timestamptz(3)
  leaseUntil        DateTime?              @db.Timestamptz(3)
  sentAt            DateTime?              @db.Timestamptz(3)
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)
  application       StudentApplication?    @relation(fields: [applicationId], references: [id], onDelete: Restrict)
  inquiry           GeneralInquiry?        @relation(fields: [inquiryId], references: [id], onDelete: Restrict)
  adminUser         AdminUser?             @relation(fields: [adminUserId], references: [id], onDelete: Restrict)

  @@index([state, nextAttemptAt, retryUntil])
  @@index([state, leaseUntil])
  @@index([applicationId])
  @@index([inquiryId])
  @@index([adminUserId])
}
