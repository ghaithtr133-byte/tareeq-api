{
  "name": "tareeq-api",
  "version": "0.1.0",
  "private": true,
  "description": "Standalone backend API for Tareeq Academy.",
  "type": "module",
  "engines": {
    "node": "24.x"
  },
  "packageManager": "npm@11.6.2",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/server.ts",
    "start": "node --env-file-if-exists=.env dist/server.js",
    "postinstall": "prisma generate",
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:api": "vitest run test/app.test.ts test/auth.test.ts test/content.api.test.ts",
    "postman:generate": "tsx scripts/postman.ts generate",
    "postman:check": "tsx scripts/postman.ts check",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "prisma:migrate:status": "prisma migrate status",
    "prisma:migrate:dev": "prisma migrate dev",
    "prisma:migrate:deploy": "prisma migrate deploy",
    "auth:bootstrap": "tsx --env-file-if-exists=.env scripts/bootstrap-super-admin.ts"
  },
  "dependencies": {
    "@hono/node-server": "2.1.5",
    "@hono/zod-openapi": "1.6.3",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@scalar/hono-api-reference": "0.12.12",
    "argon2": "0.45.1",
    "dotenv": "18.0.8",
    "hono": "4.13.13",
    "jose": "6.2.12",
    "pg": "8.23.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "eslint": "10.12.0",
    "prisma": "7.10.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "typescript-eslint": "8.71.2",
    "vitest": "5.0.4"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.6"
  }
}
